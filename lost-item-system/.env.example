# 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置值

# Flask 应用配置
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# 数据库配置
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=loss_system

# 安全配置
SECRET_KEY=your_secret_key_here

# 业务逻辑配置
# 自动归档天数（超过此天数的记录将被自动归档）
AUTO_ARCHIVE_DAYS=14

# 搜索和分页配置
SEARCH_RESULTS_LIMIT=20
HOME_PAGE_ITEMS_LIMIT=6

# 用户验证配置
USERNAME_MIN_LENGTH=3
USERNAME_MAX_LENGTH=20
PASSWORD_MIN_LENGTH=6

# 打赏配置
MIN_REWARD_AMOUNT=0.01
MAX_REWARD_AMOUNT=10000.00

# 文本长度限制
MAX_DESCRIPTION_LENGTH=1000
MAX_HIDDEN_INFO_LENGTH=500
MAX_LOCATION_LENGTH=100
MAX_ITEM_NAME_LENGTH=50

# 联系信息配置
MAX_CONTACT_LENGTH=100
MAX_FREE_TIME_LENGTH=100
MAX_PERSONAL_INFO_LENGTH=500

# 系统行为配置
AUTO_REFRESH_DELAY=1500
SUCCESS_MESSAGE_DURATION=3000

# 数据库连接池配置
DB_POOL_SIZE=5
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=3600
DB_MAX_OVERFLOW=10

# Python路径配置
PYTHONPATH=${PYTHONPATH}:${PWD}

# 高德地图环境变量
export AMAP_API_KEY="8eab57b8c12c66104c1776924242f945"
export AMAP_SECURITY_CODE="90bbadc2211f93cb8c4fb71eb676acfe"